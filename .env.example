APP_NAME=Customs AI Checker
APP_ENV=development
LOG_LEVEL=INFO

# Ingestion settings
MAX_UPLOAD_SIZE_MB=50
UPLOAD_ROOT=data/uploads
DB_PATH=data/app.db

# TASK-005A local vision (optional)
VISION__ENABLED=false
VISION__ACCURACY_MODE=true
VISION__RENDER_DPI=200
VISION__MAX_RENDER_PIXELS=16000000
VISION__MAX_VISUAL_PAGES=50
VISION__MIN_MEANINGFUL_CHARS=12
VISION__MAX_CONTROL_RATIO=0.02
VISION__MAX_REPLACEMENT_RATIO=0.01
VISION__MIN_MEANINGFUL_RATIO=0.45
VISION__MIN_CONFIDENCE_THRESHOLD=0.55
VISION__MIN_SOFT_TEXT_OVERLAP=0.35
VISION__VLM_LOCAL_ENDPOINT=http://127.0.0.1:9090/layout-parsing
VISION__VLM_CONNECT_TIMEOUT_SECONDS=2
VISION__VLM_READ_TIMEOUT_SECONDS=60
VISION__VLM_MAX_RESPONSE_BYTES=5000000
VISION__VLM_MAX_CONCURRENCY=1

